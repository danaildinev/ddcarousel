{
	"name": "ddcarousel",
	"version": "1.4.2",
	"description": "Simple and fast carousel slider written in vannila JS",
	"type": "module",
	"main": "./dist/ddcarousel.esm.js",
	"module": "./dist/ddcarousel.esm.js",
	"types": "./dist/ddcarousel.d.ts",
	"unpkg": "./dist/ddcarousel.umd.min.js",
	"jsdelivr": "./dist/ddcarousel.umd.min.js",
	"exports": {
		".": {
			"types": "./dist/ddcarousel.d.ts",
			"import": "./dist/ddcarousel.esm.js",
			"default": "./dist/ddcarousel.esm.js"
		},
		"./ddcarousel.css": "./dist/ddcarousel.css",
		"./ddcarousel.min.css": "./dist/ddcarousel.min.css"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "vitest run",
		"build:all": "npm run build:prod && npm run build:types && npm run bundle:types && npm run clean:types",
		"build:prod": "webpack",
		"build:dev": "webpack serve --env dev",
		"build:types": "tsc --emitDeclarationOnly",
		"type-check": "tsc --noEmit",
		"bundle:types": "api-extractor run --local",
		"clean:types": "node utils/clean-types.js",
		"demo:build": "node ./utils/setup-demo.js",
		"demo:watch:css": "sass --watch --no-source-map ./showcase/styles/demos/demos.scss:./showcase/dist/demos.css"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/danaildinev/ddcarousel.git"
	},
	"keywords": [
		"js",
		"carousel",
		"slider",
		"vanilla",
		"free"
	],
	"author": "Danail Dinev",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/danaildinev/ddcarousel/issues"
	},
	"homepage": "https://github.com/danaildinev/ddcarousel#readme",
	"devDependencies": {
		"@microsoft/api-extractor": "^7.58.12",
		"@testing-library/dom": "^10.4.1",
		"@types/jsdom": "^28.0.3",
		"concurrently": "^10.0.5",
		"css-loader": "^7.1.4",
		"jsdom": "^29.1.1",
		"mini-css-extract-plugin": "^2.10.1",
		"sass": "^1.103.1",
		"sass-loader": "^16.0.7",
		"terser-webpack-plugin": "^5.4.0",
		"ts-loader": "^9.5.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.9",
		"webpack": "^5.105.4",
		"webpack-cli": "^6.0.1",
		"webpack-dev-server": "^6.0.0"
	}
}